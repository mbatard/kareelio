# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kareelio
POSTGRES_USER=kareelio
POSTGRES_PASSWORD=changeme

# Backend
SERVER_PORT=8080
SESSION_SECRET=changeme-use-secure-random-string
SESSION_COOKIE_SAMESITE=lax
SESSION_DURATION_HOURS=72
DEFAULT_ADMIN_EMAIL=admin@kareelio.local
DEFAULT_ADMIN_PASSWORD=admin
CORS_ORIGIN=http://localhost:5173
DB_MIGRATE=true

# Registration & Email Verification
APP_PUBLIC_URL=http://localhost:5173
REGISTRATION_ENABLED=true
VERIFICATION_TOKEN_TTL_HOURS=24

# SMTP (leave SMTP_USERNAME and SMTP_PASSWORD empty for unauthenticated relay)
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@kareelio.fr

# Job application encryption (generate DATA_ENCRYPTION_KEY with: openssl rand -base64 32)
DATA_ENCRYPTION_KEY_ID=primary
DATA_ENCRYPTION_KEY=
JOB_APPLICATIONS_BACKFILL=false
JOB_APPLICATIONS_BACKFILL_DRY_RUN=true
JOB_APPLICATIONS_REQUIRE_ENCRYPTED_READS=false

# Frontend
VITE_API_URL=http://localhost:8080
